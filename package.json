{
  "name": "moneysecurity-nestjs-js",
  "version": "0.0.1",
"description": "MoneySecurity backend — NestJS + Prisma",
  "author": "",
  "private": true,
  "license": "UNICENSED",
  "scripts": {
    "start": "node index.js",
    "start:dev": "node ./node_modules/nodemon/bin/nodemon.js",
    "start:prod": "node index.js",
    "format": "node ./node_modules/prettier/bin/prettier.cjs --write \"src/**/*.js\" \"scripts/*.js\" \"prisma/seed.js\"",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js",
    "test:cov": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --coverage",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up -d db",
    "db:migrate": "node ./node_modules/prisma/build/index.js migrate dev && npm run prisma:generate",
    "db:deploy": "node ./node_modules/prisma/build/index.js migrate deploy",
    "db:seed": "node ./node_modules/prisma/build/index.js db seed",
    "db:studio": "node ./node_modules/prisma/build/index.js studio",
    "prisma:generate": "node ./node_modules/prisma/build/index.js generate",
    "smoke": "node scripts/smoke.js"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/jwt": "^12.0.2",
    "@nestjs/passport": "^12.0.0",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/swagger": "^12.0.2",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "bcryptjs": "^3.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.2.0"
  },
  "devDependencies": {
    "@babel/core": "8.0.1",
    "@babel/plugin-proposal-decorators": "8.0.2",
    "@babel/plugin-transform-runtime": "8.0.1",
    "@babel/preset-env": "8.0.2",
    "@babel/register": "8.0.1",
    "@babel/runtime": "8.0.0",
    "@nestjs/mau": "^0.2.6",
    "@nestjs/testing": "^12.0.1",
    "dotenv": "^18.0.5",
    "jest": "30.4.2",
    "nodemon": "3.1.14",
    "prettier": "3.9.6",
    "prisma": "^7.10.0",
    "supertest": "7.2.2"
  }
}
