# App
NODE_ENV=development
PORT=3000

# Database (lokal: npm run db:up)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/moneysecurity_nest?schema=public"

# Auth
JWT_SECRET=ganti-dengan-string-acak-panjang
JWT_EXPIRES_IN=1d

# WSL/NTFS saja: repo di drive Windows tidak bisa mengeksekusi binary Prisma.
# Salin binary ke Linux fs (chmod +x), lalu isi path-nya di sini:
# PRISMA_SCHEMA_ENGINE_BINARY=/home/<user>/.cache/prisma-engines/schema-engine-debian-openssl-3.0.x